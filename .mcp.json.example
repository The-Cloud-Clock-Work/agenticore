{
    "_comment": "Copy this file to .mcp.json and set the corresponding env vars in your .env file.",
    "mcpServers": {
        "anton": {
            "command": "${ANTONCORE_PYTHON}",
            "args": [
                "${ANTONCORE_MCP_DIR}/anton_server.py"
            ],
            "env": {
                "ANTON_HOST": "${ANTON_HOST}",
                "ANTON_USER": "${ANTON_USER}",
                "ANTON_SSH_KEY": "${ANTON_SSH_KEY}",
                "ANTON_API_KEY": "${ANTON_API_KEY}"
            }
        },
        "litellm": {
            "command": "${ANTONCORE_PYTHON}",
            "args": [
                "${ANTONCORE_MCP_DIR}/litellm_server.py"
            ],
            "env": {
                "ANTON_HOST": "${ANTON_HOST}",
                "ANTON_SSH_KEY": "${ANTON_SSH_KEY}",
                "LITELLM_URL": "${LITELLM_URL}",
                "LITELLM_MASTER_KEY": "${LITELLM_MASTER_KEY}"
            }
        },
        "matrix": {
            "command": "${ANTONCORE_PYTHON}",
            "args": [
                "${ANTONCORE_MCP_DIR}/matrix_server.py"
            ],
            "env": {
                "MATRIX_URL": "${MATRIX_URL}",
                "MATRIX_API_KEY": "${MATRIX_API_KEY}"
            }
        },
        "github": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "GITHUB_PERSONAL_ACCESS_TOKEN",
                "-e",
                "GITHUB_TOOLSETS",
                "ghcr.io/github/github-mcp-server"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
                "GITHUB_TOOLSETS": "${GITHUB_TOOLSETS}"
            }
        },
        "langfuse": {
            "command": "${ANTONCORE_PYTHON}",
            "args": [
                "${ANTONCORE_MCP_DIR}/langfuse_server.py"
            ],
            "env": {
                "LANGFUSE_PUBLIC_KEY": "${LANGFUSE_PUBLIC_KEY}",
                "LANGFUSE_SECRET_KEY": "${LANGFUSE_SECRET_KEY}",
                "LANGFUSE_HOST": "${LANGFUSE_HOST}"
            }
        },
        "grafana": {
            "command": "${ANTONCORE_PYTHON}",
            "args": [
                "${ANTONCORE_MCP_DIR}/grafana_server.py"
            ],
            "env": {
                "GRAFANA_URL": "${GRAFANA_URL}",
                "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
            }
        },
        "sonar": {
            "command": "${ANTONCORE_PYTHON}",
            "args": [
                "${ANTONCORE_MCP_DIR}/sonar_server.py"
            ],
            "env": {
                "SONAR_MANAGER_URL": "${SONAR_MANAGER_URL}",
                "SONAR_MANAGER_API_KEY": "${SONAR_MANAGER_API_KEY}"
            }
        }
    }
}
