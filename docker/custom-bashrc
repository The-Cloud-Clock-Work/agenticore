# Agenticore container shell config
# Appended to ~/.bashrc by entrypoint.sh

# Core aliases
anton() { ANTHROPIC_AUTH_TOKEN="${LITELLM_MCP_GATEWAY_KEY:-${ANTHROPIC_AUTH_TOKEN:-}}" claude --dangerously-skip-permissions "$@"; }
alias cc='claude --dangerously-skip-permissions'
alias gs='git status'
alias gp='git push'
gc() { git add -A && git commit -m "$(claude -p 'Write a short conventional commit message for this diff. Output ONLY the message, nothing else.' <<< "$(git diff --cached --stat)")"; }

# wkt-get — search Claude projects, pick one, cd into it
# (overridden by colt-tools version if installed)
wkt-get() {
  local query="${1:-}" projects_dir="$HOME/.claude/projects"
  local -a base_paths=()
  for proj_dir in "$projects_dir"/*/; do
    local dir_name="${proj_dir%/}"; dir_name="${dir_name##*/}"
    [[ "$dir_name" == *"--worktree"* ]] && continue
    local idx="$proj_dir/sessions-index.json"
    [ -f "$idx" ] || continue
    local orig_path
    orig_path=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('originalPath',''))" "$idx" 2>/dev/null)
    [ -n "$orig_path" ] && [ -d "$orig_path" ] || continue
    if [ -z "$query" ] || [[ "${orig_path,,}" == *"${query,,}"* ]]; then base_paths+=("$orig_path"); fi
  done
  [ ${#base_paths[@]} -gt 0 ] || { echo "No projects found${query:+ matching '$query'}"; return 1; }
  local i=1; for p in "${base_paths[@]}"; do printf "%d) %s\n" "$i" "$p"; ((i++)); done
  local sel; read -rp "Project [1-${#base_paths[@]}]: " sel
  [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#base_paths[@]}" ] || { echo "Invalid"; return 1; }
  echo "-> ${base_paths[$((sel-1))]}"; cd "${base_paths[$((sel-1))]}" || return 1
}

# Help / welcome message
helpme() {
  echo "========================================"
  echo "  Anton Terminal - Web CLI Access"
  echo "========================================"
  echo ""
  echo "  Terminal Commands:"
  echo "    anton [args]     Start Claude on workspace"
  echo "    cc [args]        Claude (skip permissions)"
  echo "    gc               Auto-commit with AI message"
  echo "    gs / gp          Git status / push"
  echo "    helpme           Show this help"
  echo ""
  if [ -d "$HOME/colt-tools" ]; then
  echo "  Colt-Tools:  (run 'colt-tools-help' for full list)"
  echo "    wkt-get [q]      Find Claude project/worktree"
  echo "    gw <branch>      Create/switch git worktree"
  echo "    claude-login     Switch Claude auth profile"
  echo "    cskip            Claude --dangerously-skip-permissions"
  echo "    gsec / gget      GitHub org secret management"
  echo "    getsec / setsec  AWS Secrets Manager CLI"
  echo "    loadenv [file]   Source .env file"
  echo "    geven            Show AWS caller identity"
  echo "    colt-tools-help  Show all tools in the toolbelt"
  echo ""
  fi
}

# Show welcome on login
helpme
