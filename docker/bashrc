# Agenticore container shell config

# Core aliases & functions
alias cc='claude --dangerously-skip-permissions'
alias gs='git status'
alias gp='git push'
gc() { git add -A && git commit -m "$(claude -p 'Write a short conventional commit message for this diff. Output ONLY the message, nothing else.' <<< "$(git diff --cached --stat)")"; }
agenti() {
  local pkg_dir
  pkg_dir="$(curl -s http://localhost:8200/health 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin).get("package_dir",""))' 2>/dev/null)"
  if [ -z "$pkg_dir" ] && [ -n "$AGENTIHUB_AGENT" ]; then
    pkg_dir="${AGENTICORE_CLONE_ROOT:-${AGENTICORE_SHARED_FS_ROOT:-$HOME}}/agentihub/agents/${AGENTIHUB_AGENT}/package"
  fi
  pkg_dir="${pkg_dir:-/app/package}"
  [ -d "$pkg_dir" ] || { echo "package_dir not found: $pkg_dir"; return 1; }
  cd "$pkg_dir" && unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL && claude --dangerously-skip-permissions "$@"
}
agentipull() {
  # agentihooks ships as a PyPI dep — no re-sync. Pull content repos (bundle +
  # agentihub) and re-run agentihooks init so whitelist/profile state catches
  # up. Pass "--with-agentihooks" to also re-sync the agentihooks clone (only
  # meaningful when AGENTICORE_AGENTIHOOKS_URL override is set).
  local target="bundle,agentihub"
  if [ "${1:-}" = "--with-agentihooks" ]; then target="all"; fi
  echo "Pulling content repos (target=$target)..."
  for t in ${target//,/ }; do agenticore hooks sync --target "$t"; done
  agentihooks init
  echo "Done."
}

# wkt-get — list agenticore worktrees, pick one, cd into it
wkt-get() {
  local query="${1:-}" wt_root="$HOME/.agenticore/worktrees"
  [ -d "$wt_root" ] || { echo "No worktrees dir: $wt_root"; return 1; }
  local -a dirs=() names=()
  for d in "$wt_root"/*/; do
    [ -d "$d" ] || continue
    local name="${d%/}"; name="${name##*/}"
    if [ -z "$query" ] || [[ "${name,,}" == *"${query,,}"* ]]; then
      dirs+=("$d"); names+=("$name")
    fi
  done
  [ ${#dirs[@]} -gt 0 ] || { echo "No worktrees${query:+ matching '$query'}"; return 1; }
  local i=1; for n in "${names[@]}"; do printf "%d) %s\n" "$i" "$n"; ((i++)); done
  if [ ${#dirs[@]} -eq 1 ]; then
    echo "-> ${dirs[0]}"; cd "${dirs[0]}" || return 1; return 0
  fi
  local sel; read -rp "Worktree [1-${#dirs[@]}]: " sel
  [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#dirs[@]}" ] || { echo "Invalid"; return 1; }
  echo "-> ${dirs[$((sel-1))]}"; cd "${dirs[$((sel-1))]}" || return 1
}

# Welcome banner
helpme() {
  echo "    agenti           Claude with OAuth auth (cd into agent package)"
  echo "    agenticore       Server management"
  echo "    agentihooks      Hooks/skills/profile manager"
  echo "    helpme           Show this help"
}

# Only print the banner for interactive shells. Non-interactive invocations
# (claude's Bash tool, kubectl exec without -t, scripts) must not have the
# banner leak into stdout — it pollutes tool_result output and confuses
# chat clients seeing the SSE stream.
case $- in
    *i*) helpme ;;
esac
